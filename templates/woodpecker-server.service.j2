[Unit]
Description=WoodpeckerCI server
Documentation=https://woodpecker-ci.org/docs/administration/server-config
Requires=network.target
After=network.target
ConditionFileNotEmpty={{ woodpecker_config_dir }}{{ instance.name }}-woodpecker-server.env
ConditionPathExists={{ woodpecker_config_dir }}{{ instance.name }}-woodpecker-server.env

[Service]
Type=simple
EnvironmentFile={{ woodpecker_config_dir }}{{ instance.name }}-woodpecker-server.env
User=root
Group=root
ExecStart=/usr/local/bin/woodpecker-server
WorkingDirectory=/var/lib/woodpecker/
StateDirectory=woodpecker

[Install]
WantedBy=multi-user.target
