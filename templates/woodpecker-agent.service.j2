[Unit]
Description=WoodpeckerCI agent
Documentation=https://woodpecker-ci.org/docs/administration/configuration/agent
Requires=network.target
After=network.target
ConditionFileNotEmpty={{ woodpecker_config_dir }}{{ instance.name }}-woodpecker-agent.env
ConditionPathExists={{ woodpecker_config_dir }}{{ instance.name }}-woodpecker-agent.env

[Service]
Type=simple
EnvironmentFile={{ woodpecker_config_dir }}{{ instance.name }}-woodpecker-agent.env
User=root
Group=root
ExecStart=/usr/local/bin/woodpecker-agent
WorkingDirectory=/var/lib/woodpecker/
StateDirectory=woodpecker

[Install]
WantedBy=multi-user.target
