WOODPECKER_SERVER={{ instance.name }}.{{ instance.domainName }}:{{ instance.rpcPort }}
WOODPECKER_AGENT_SECRET={{ instance.agentSecret }}
WOODPECKER_HOSTNAME={{ ansible_hostname }}{% if instance.backend is defined %}_{{ instance.backend }}{% endif %}

WOODPECKER_AGENT_CONFIG_FILE={{ woodpecker_config_dir }}agent-{{ instance.clientName }}.conf

{% if instance.backend is defined %}
WOODPECKER_BACKEND={{ instance.backend }}
{% endif %}

{% if WOODPECKER_AGENT_LABELS is defined %}
WOODPECKER_AGENT_LABELS="{{ WOODPECKER_AGENT_LABELS }}"
{% endif %}

{% if instance.volume is defined %}
WOODPECKER_VOLUME={{ instance.volume }}
{% endif %}


WOODPECKER_HEALTHCHECK_ADDR=localhost:{{ 4000 + ansible_loop.index }}
WOODPECKER_HEALTHCHECK=true

